# 85 BARBERÍA — variables de entorno
# Copia este archivo a .env.local y rellena los valores. .env.local NO se commitea.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
# URL del proyecto, p. ej. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (publishable / anon). Segura para el navegador; la protege RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (secret / service_role). SOLO servidor. Nunca con prefijo NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# --- Supabase CLI (solo para aplicar migraciones; la app no las usa) ---
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Cron (protege /api/cron/keepalive; genera un valor aleatorio largo) ---
CRON_SECRET=

# --- Opcional: región del pooler si tu proyecto no está en us-east-1 ---
# (Supabase > Connect > Session pooler muestra el host exacto)
# SUPABASE_POOLER_HOST=aws-0-us-east-1.pooler.supabase.com
